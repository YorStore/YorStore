# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables (Production).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional if using a specific verified sender (recommended):
# RESEND_FROM_EMAIL=Yorstore <hello@yorstore.co.uk>
#
# If omitted in production, defaults to: Yorstore <hello@yorstore.co.uk>
# Enquiries are delivered to: info@yorstore.co.uk
