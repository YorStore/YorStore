# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Verified domain sender in Resend (required for production)
# Example after verifying yorstore.co.uk:
RESEND_FROM_EMAIL=Yorstore Enquiries <enquiries@yorstore.co.uk>

# Local dev only: if RESEND_FROM_EMAIL is omitted, onboarding@resend.dev is used automatically
